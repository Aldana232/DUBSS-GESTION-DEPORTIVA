# =============================================================================
# DUBSS — Variables de PRODUCCIÓN
# Cópialo a "deploy/.env" (Git lo ignora) o, mejor, deja que lo cree  ./scripts/generar-env.sh
# con contraseñas y claves aleatorias. NUNCA subas el .env a Git ni lo compartas por chat o correo.
# =============================================================================

# ─── Dirección pública ───────────────────────────────────────────────────────
DOMINIO=dubss.ejemplo.bo            # solo el dominio, sin https://  (para probar en tu PC: localhost)
ESQUEMA=https                       # https en un servidor real; http únicamente para probar en tu PC
USAR_HTTPS=true                     # true en un servidor real; false únicamente para probar por http://localhost

# Ruta del panel de administración de Django. Cámbiala por algo difícil de adivinar (generar-env.sh lo hace).
ADMIN_URL=panel-cambiame/
# Documentación interactiva de la API (Swagger). Apagada por seguridad; actívala solo mientras la necesites.
API_DOCS_ENABLED=false

# ─── Seguridad ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CAMBIAME_clave_larga_y_aleatoria_de_50_o_mas_caracteres
POSTGRES_DB=dubss_db
POSTGRES_USER=dubss_user
POSTGRES_PASSWORD=CAMBIAME_contrasena_larga_y_aleatoria
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Correo (avisos del sistema) ─────────────────────────────────────────────
# Con Gmail: activa la verificación en 2 pasos y crea una «contraseña de aplicación» (Cuenta Google > Seguridad).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="DUBSS <no-responder@uagrm.edu.bo>"

# ─── Inteligencia artificial (opcional) ──────────────────────────────────────
# Clave gratuita en https://console.groq.com. Sin ella el asistente usa reglas y el agente queda desactivado.
GROQ_API_KEY=
LLM_PROVIDER=groq
STT_PROVIDER=groq

# ─── Notificaciones push (opcional) ──────────────────────────────────────────
# Copia el JSON de la cuenta de servicio de Firebase a deploy/secrets/firebase.json y deja esta línea así:
FCM_CREDENTIALS_FILE=/app/secrets/firebase.json

# ─── Textos legales ──────────────────────────────────────────────────────────
LEGAL_VERSION=2026-11-15            # debe coincidir con frontend/lib/legal.config.ts

# ─── n8n + WhatsApp (opcional; se activa con:  docker compose --profile n8n up -d) ─────────────────
N8N_URL_EVENTOS=
N8N_SECRETO=
N8N_ENCRYPTION_KEY=
N8N_VERSION=1.123.27           # versión probada de n8n; súbela solo después de probar los flujos
WHATSAPP_PAIS_DEFECTO=591
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=dubss_aviso
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0     # solo para pruebas con un simulador

# ─── Respaldos ───────────────────────────────────────────────────────────────
HORA_RESPALDO=03:15                 # hora de Bolivia (La Paz)
RETENCION_DIAS=14                   # cuántos días se conservan los respaldos en el servidor
