# Django
DJANGO_SECRET_KEY=desarrollo-inseguro-no-usar-en-produccion-cambiala-por-una-clave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Seguridad del login; NUM_PROXIES=1 cuando nginx es el proxy frontal
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_THROTTLE_RATE=10/min
NUM_PROXIES=0

# PostgreSQL
POSTGRES_DB=dubss_db
POSTGRES_USER=dubss_user
POSTGRES_PASSWORD=dubss_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# APIs externas
GROQ_API_KEY=
LLM_PROVIDER=groq
STT_PROVIDER=groq
OPENWEATHER_API_KEY=
FIREBASE_SERVER_KEY=/app/secrets/firebase.json

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Redis para Celery (tareas programadas). En Docker ya apunta al servicio redis.
# REDIS_URL=redis://redis:6379/0
# Clima: Open-Meteo no requiere clave. Coordenadas del campus (opcional):
# CLIMA_LATITUD=-17.7833
# CLIMA_LONGITUD=-63.1821
# Push (Firebase Cloud Messaging v1): ruta del JSON de la cuenta de servicio dentro del contenedor.
FCM_CREDENTIALS_FILE=
# IA del asistente por voz: clave gratuita en https://console.groq.com (sin clave funciona con reglas locales).
# LLM_PROVIDER=groq   # groq | ollama | reglas
# STT_PROVIDER=groq   # groq | ninguno
# URL de Django vista desde el servidor de Next (proxy y sesión httpOnly). En Docker: http://backend:8000/api/v1
# API_INTERNAL_URL=http://backend:8000/api/v1
