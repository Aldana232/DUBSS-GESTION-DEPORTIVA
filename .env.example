# =============================================================================
# Variables de entorno de DESARROLLO. Copia este archivo a ".env" (que Git ignora) y ajusta.
# Para PRODUCCIÓN usa deploy/.env.production.example: NUNCA reutilices estos valores.
# =============================================================================

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=desarrollo-inseguro-no-usar-en-produccion-cambiala-por-una-clave-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=dubss_db
POSTGRES_USER=dubss_user
POSTGRES_PASSWORD=dubss_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Sesión y seguridad del login ────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
LOGIN_THROTTLE_RATE=10/min
NUM_PROXIES=0                      # 1 cuando hay un proxy delante (Caddy/nginx), para ver la IP real del cliente

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API_INTERNAL_URL=http://backend:8000/api/v1     # cómo llega el servidor de Next a Django dentro de Docker

# ─── Correo (avisos) ─────────────────────────────────────────────────────────
# En desarrollo los correos salen por consola. En producción configura un SMTP real.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ─── Inteligencia artificial (opcional) ──────────────────────────────────────
# Clave gratuita en https://console.groq.com. Sin ella el asistente usa reglas locales y el agente queda desactivado.
GROQ_API_KEY=
LLM_PROVIDER=groq                  # groq | reglas
LLM_MODEL=openai/gpt-oss-20b
STT_PROVIDER=groq                  # groq | ninguno  (voz a texto)
STT_MODEL=whisper-large-v3-turbo
ASISTENTE_AUDIO_MAX_MB=10
AGENTE_PROVIDER=groq
AGENTE_MODEL=openai/gpt-oss-120b
AGENTE_MAX_PASOS=5                 # vueltas al modelo por petición
AGENTE_MAX_HERRAMIENTAS=8          # herramientas por petición
AGENTE_TIMEOUT_SEG=60
AGENTE_MENSAJES_HORA=60            # tope por usuario
AGENTE_ACCION_MINUTOS=30           # vigencia de una acción pendiente de confirmar
AGENTE_ANTELACION_HORAS=2          # no se reprograma un partido a menos de N horas

# ─── Reglas deportivas y del optimizador ─────────────────────────────────────
SANCION_PARTIDOS_ROJA=1
AMARILLAS_PARA_SANCION=3
WALKOVER_GOLES_GANADOR=3
FIXTURE_DESCANSO_MIN_HORAS=24
ML_FIXTURE_MAX_SEGUNDOS=8
ML_CANDIDATOS_POR_PARTIDO=40
# Clima: Open-Meteo no necesita clave. Coordenadas del campus (opcional):
# CLIMA_LATITUD=-17.7833
# CLIMA_LONGITUD=-63.1821

# ─── Notificaciones push (opcional) ──────────────────────────────────────────
# JSON de la cuenta de servicio de Firebase, dentro del contenedor (ponlo en backend/secrets/, ignorado por Git).
FCM_CREDENTIALS_FILE=

# ─── Textos legales ──────────────────────────────────────────────────────────
# Versión de los Términos y la Política de Privacidad. Al cambiarla, todos vuelven a aceptarlos.
# Debe coincidir con frontend/lib/legal.config.ts.
LEGAL_VERSION=2026-11-15

# ─── n8n + WhatsApp (opcional) ───────────────────────────────────────────────
# Genera dos valores aleatorios:  python -c "import secrets;print(secrets.token_hex(32))"
# Levanta n8n con:  docker compose -f docker-compose.dev.yml --profile n8n up -d n8n
# N8N_URL_EVENTOS=http://n8n:5678/webhook/dubss-eventos
# N8N_SECRETO=
# N8N_ENCRYPTION_KEY=
WHATSAPP_PAIS_DEFECTO=591          # prefijo para móviles de 8 dígitos sin código de país
# Credenciales de WhatsApp Cloud API (Meta). Sin ellas n8n trabaja en modo simulado (no envía nada).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_PLANTILLA=dubss_aviso
# WHATSAPP_VERIFY_TOKEN=
