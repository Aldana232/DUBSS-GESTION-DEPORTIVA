# Auto detect text files and perform LF normalization
* text=auto

# Archivos binarios: nunca convertir saltos de linea
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.joblib binary

# Scripts que corren en Linux: nunca con saltos de línea de Windows
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile* text eol=lf
